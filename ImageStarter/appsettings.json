{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Storage": {
    "ProcessesQueueName": "generation-processes",
    "ImagesQueueName": "weather-images",
    "ProcessesTableName": "CreationProcesses",
    "ImagesTableName": "GeneratedImages",
    "ImagesContainerName": "weather-images",
    "BackgroundCacheContainerName": "temp-backgrounds"
  },
  "Job": {
    "MaxMessagesPerExecution": 1,
    "MaxConcurrency": 1,
    "MaxDequeueCount": 5,
    "VisibilityTimeout": "00:05:00",
    "RetryDelay": "00:00:30"
  }
}
