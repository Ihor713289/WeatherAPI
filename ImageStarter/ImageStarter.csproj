<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>dotnet-StationDataRetriever-3a28d8bc-8f1f-4bb9-bdeb-fe30a4300ac0</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <!-- Image name for 'dotnet publish -t:PublishContainer' (used by deploy.ps1). -->
        <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
        <ContainerRepository>weatherapi-starter</ContainerRepository>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.2.26504.105" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-rc.2.26504.105" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\WeatherAPI.Shared\WeatherAPI.Shared.csproj" />
    </ItemGroup>
</Project>
