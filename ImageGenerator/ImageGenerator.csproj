<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>dotnet-ImageGenerator-658160b4-4c38-4627-836a-41ba3d3ef3c5</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <!-- Image name for 'dotnet publish -t:PublishContainer' (used by deploy.ps1). -->
        <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
        <ContainerRepository>weatherapi-generator</ContainerRepository>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.2.26504.105" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-rc.2.26504.105" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- Bundled fonts (Apache 2.0), loaded by WeatherImageRenderer. -->
        <None Include="Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\WeatherAPI.Shared\WeatherAPI.Shared.csproj" />
    </ItemGroup>
</Project>
